<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#0a1020"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"><title>Mandarin Procurement</title><link rel="manifest" href="manifest.webmanifest"><link rel="stylesheet" href="assets/app.css"></head><body><div class="app"><aside class="side"><div class="brand">Mandarin Procurement</div><p class="sub">Program procurement & supplier China</p><nav class="nav"><button data-session="session-1">Sesi 1 — Nada & Perkenalan</button><button data-session="session-2">Sesi 2 — Perusahaan & Jabatan</button><button data-session="session-3">Sesi 3 — Angka & Quantity</button></nav><div class="ios-note"><b>Audio perangkat</b><p id="audioStatus" class="audio-status">Mendeteksi voice Mandarin…</p><div class="actions"><button class="btn secondary" data-audio-mode="auto">Otomatis</button><button class="btn secondary" data-audio-mode="ios">iOS/iPadOS</button><button class="btn secondary" data-audio-mode="android">Android</button></div><p id="audioModeText" class="muted">Mode otomatis.</p></div></aside><main class="main"><div class="card"><span class="badge done">GitHub Pages Edition</span><h1>Mandarin untuk Procurement</h1><p class="lead">Sesi 1–3 modular. Materi, CSS, dan JavaScript dipisahkan agar mudah dikembangkan sampai Sesi 24.</p><button id="openActive" class="btn">Buka Sesi Aktif</button></div><div id="lesson"></div></main></div><script src="assets/app.js"></script></body></html>